{
  "name": "airbnb-dashboard-sample01",
  "version": "0.1.0",
  "private": true,
  "description": "Empire Command: The Empire Stays Airbnb command center (web + Android) with Jarvis voice hero, money/RevPAR dashboard, data builder and n8n automations.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "next build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:html": "node scripts/build-html.mjs",
    "jarvis": "tsx jarvis/server.ts",
    "mcp": "tsx mcp/server.ts",
    "build:pages": "PAGES_BASE_PATH=/airbnb-dashboard-sample01 next build"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
