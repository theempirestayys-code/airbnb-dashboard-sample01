# Copy to .env (never committed) and fill in. Used by `npm run jarvis` and the MCP server.

# Any OpenAI-compatible API. Default: OpenRouter, running Grok models.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Maya + Arjun (planning and the final answer), then the other 12 agents
LLM_MODEL_LEAD=x-ai/grok-4.7
LLM_MODEL_AGENT=x-ai/grok-4.3

# Other providers: change the base URL, key and both models above.
#   xAI direct:  LLM_BASE_URL=https://api.x.ai/v1           models e.g. grok-4.3
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1     models e.g. gpt-5-mini
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1     no key, models e.g. llama3.1

# Local data (stays on this Mac). Defaults point at the ERA 2.0 build folder.
# ERA2_AGENTS_DIR=/Users/tes/Documents/_ERA 2.0 (29 Sep 2026)/ERA2_Build/04_Agents
# TES_PORTFOLIO_JSON=/Users/tes/Documents/_ERA 2.0 (29 Sep 2026)/ERA2_Build/00_Command/portfolio.json
# Force sample data even when portfolio.json exists:
# TES_DATA=sample
# JARVIS_PORT=8787
